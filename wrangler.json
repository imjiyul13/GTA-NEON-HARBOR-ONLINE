{
  "name": "neon-harbor",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "not_found_handling": "none"
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "GameRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameRoom"] }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "*",
    "MAX_PLAYERS": "8"
  },
  "observability": { "enabled": true }
}
